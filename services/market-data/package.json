{
  "name": "@qmi/market-data",
  "version": "0.0.0",
  "private": true,
  "description": "Exchange adapters and WebSocket ingestion behind a common interface (Phase 1: Binance spot, BTC/ETH)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint . --ext .ts"
  },
  "dependencies": {
    "@qmi/config": "workspace:*",
    "@qmi/contracts": "workspace:*",
    "@qmi/observability": "workspace:*",
    "pg": "^8.13.1",
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
