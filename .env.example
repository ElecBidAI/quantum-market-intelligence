# Copy to .env and fill in real values locally. Never commit .env.
# This file documents required configuration; it contains no secrets.

# --- General ---
NODE_ENV=development
LOG_LEVEL=info

# --- apps/api ---
API_PORT=4000

# --- Database (PostgreSQL / TimescaleDB) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=qmi
POSTGRES_USER=qmi
POSTGRES_PASSWORD=qmi_dev_password
DATABASE_URL=postgres://qmi:qmi_dev_password@localhost:5432/qmi

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- apps/web ---
# Must be reachable from the browser (Next.js inlines NEXT_PUBLIC_* at build time).
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Exchange API keys (execution phases only; unset through Phase 9) ---
# Least-privilege, no-withdrawal keys only. See docs/risk/RISK-GOVERNANCE.md.
# services/market-data uses Binance's public market-data streams and needs
# no key at all.
# EXCHANGE_API_KEY=
# EXCHANGE_API_SECRET=
